<!DOCTYPE html>
<html lang="id">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta charset="UTF-8">
  <title>Monitoring Data</title>
  <!-- External Stylesheet -->
  <link rel="stylesheet" href="/stylesmonitor.css?v=<%= Date.now() %>">
  <!-- Flatpickr CSS and Material Blue Theme -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css" />

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  
</head>
<body>
  <!-- Header Navigation -->
  <nav>
    <ul>
      <li><a href="/admin"><i class="fas fa-user-cog"></i> Admin</a></li>
      <li><a href="/inspection"><i class="fas fa-search"></i> Inspection</a></li>
      <li><a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
      <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </nav>

  <h1>Monitoring Data</h1>
  <form action="/monitoring" method="get">
    <label for="startDate">Tanggal Mulai:</label>
    <input type="text" id="startDate" name="startDate" value="<%= startDate %>" placeholder="YYYY-MM-DD 00:00:00">
    <label for="endDate">Tanggal Akhir:</label>
    <input type="text" id="endDate" name="endDate" value="<%= endDate %>" placeholder="YYYY-MM-DD 00:00:00">
    <button type="submit">Tampilkan</button>
  </form>

  <!-- Catatan Section with 4 Columns -->
  <div id="notes">
    <h2>Catatan</h2>
    <button id="copyNotes">Salin</button>
    <div class="notes-container">
      <!-- Column 1: Lantai tanpa patroli (record_type = 'No Record') -->
      <div class="notes-list">
        <h3>Tidak Ada Patroli</h3>
        <ul>
          <% 
            let floorsNoPatrol = [];
            data.forEach(item => {
              if(item.record_type === 'No Record' && !floorsNoPatrol.find(f => f.lantai_id === item.lantai_id)) {
                floorsNoPatrol.push({ lantai_id: item.lantai_id, nama_lantai: item.nama_lantai });
              }
            });
            if (floorsNoPatrol.length === 0) { 
          %>
            <li>Semua lantai telah dipatroli.</li>
          <% } else { 
               floorsNoPatrol.forEach(floor => { %>
            <li>Lantai <%= floor.nama_lantai %> (ID: <%= floor.lantai_id %>) tidak ada patroli.</li>
          <%   });
             } %>
        </ul>
      </div>

      <!-- Prepare grouped data for floors with records (duplicate_count = 1) -->
      <%
        let grouped = {};
        data.forEach(item => {
          if(item.record_type !== 'No Record') {
            if(!grouped[item.lantai_id]) {
              grouped[item.lantai_id] = { nama_lantai: item.nama_lantai, records: [] };
            }
            grouped[item.lantai_id].records.push(item);
          }
        });
      %>

      <!-- Column 2: Patroli 1 Kali (record exists and monitoringCount matches total aset) -->
      <div class="notes-list">
        <h3>Patroli 1 Kali</h3>
        <ul>
          <%
            let floorsPatrolOK = [];
            let keys = Object.keys(grouped);
            if(keys.length === 0) { 
          %>
            <li>Tidak ada lantai dengan record.</li>
          <% } else {
               keys.forEach(lantaiId => {
                 let group = grouped[lantaiId];
                 let hasUnique = group.records.some(r => r.duplicate_count == 1);
                 if(hasUnique) {
                   let monitoringCount = group.records.length;
                   let asetItem = asetPerLantai.find(a => a.lantai_id == lantaiId);
                   let totalAset = asetItem ? asetItem.total_aset : 0;
                   if(monitoringCount === totalAset) {
                     floorsPatrolOK.push({ lantai_id: lantaiId, nama_lantai: group.nama_lantai });
                   }
                 }
               });
               if(floorsPatrolOK.length === 0) {
          %>
            <li>Tidak ada laporan patroli 1 kali.</li>
          <% } else {
                   floorsPatrolOK.forEach(floor => { %>
            <li>Lantai <%= floor.nama_lantai %> (ID: <%= floor.lantai_id %>) hanya dipatroli 1 kali.</li>
          <%     });
               }
             }
          %>
        </ul>
      </div>

      <!-- Column 3: Perlu Pengecekan (record exists with duplicate_count = 1 but monitoringCount does not match total aset) -->
      <div class="notes-list">
        <h3>Perlu Pengecekan</h3>
        <ul>
          <%
            let floorsNeedCheck = [];
            keys.forEach(lantaiId => {
              let group = grouped[lantaiId];
              let hasUnique = group.records.some(r => r.duplicate_count == 1);
              if(hasUnique) {
                let monitoringCount = group.records.length;
                let asetItem = asetPerLantai.find(a => a.lantai_id == lantaiId);
                let totalAset = asetItem ? asetItem.total_aset : 0;
                if(monitoringCount !== totalAset) {
                  floorsNeedCheck.push({ lantai_id: lantaiId, nama_lantai: group.nama_lantai, monitoringCount, totalAset });
                }
              }
            });
            if(floorsNeedCheck.length === 0) {
          %>
            <li>Tidak ada yang perlu pengecekan.</li>
          <% } else {
                   floorsNeedCheck.forEach(floor => { %>
            <li>Lantai <%= floor.nama_lantai %> (ID: <%= floor.lantai_id %>): Patroli 1 kali, namun record (<%= floor.monitoringCount %>) tidak sesuai dengan total aset (<%= floor.totalAset %>).</li>
          <%     });
               }
          %>
        </ul>
      </div>

      <!-- Column 4: Total Aset per Lantai -->
      <div class="notes-list">
        <h3>Total Aset per Lantai</h3>
        <ul>
          <% 
            if (!asetPerLantai || asetPerLantai.length === 0) { 
          %>
            <li>Tidak ada data aset.</li>
          <% } else {
               asetPerLantai.forEach(aset => { %>
            <li>Lantai <%= aset.nama_lantai %> (ID: <%= aset.lantai_id %>): Total aset <%= aset.total_aset %></li>
          <%   });
             } %>
        </ul>
      </div>
    </div>
  </div>

  <button id="toggleTableBtn">Tampilkan Tabel Monitoring</button>


  <!-- Monitoring Data Table -->
  <div id="tableContainer" style="display: none;">
    <table>
    <thead>
      <tr>
        <th>No.</th>
        <th>Row Index per Lantai</th>
        <th>Combined Tipe ID</th>
        <th>Nama Tipe</th>
        <th>Lantai ID</th>
        <th>Nama Lantai</th>
        <th>Duplicate Count</th>
        <th>Record Type</th>
      </tr>
    </thead>
    <tbody>
      <% if (data.length > 0) { %>
        <% data.forEach(function(item){ %>
          <tr>
            <td data-label="No."><%= item.overall_row_index %></td>
            <td data-label="Row Index per Lantai"><%= item.row_index_per_lantai %></td>
            <td data-label="Combined Tipe ID"><%= item.combined_tipe_id ? item.combined_tipe_id : '-' %></td>
            <td data-label="Nama Tipe"><%= item.nama_tipe ? item.nama_tipe : '-' %></td>
            <td data-label="Lantai ID"><%= item.lantai_id %></td>
            <td data-label="Nama Lantai"><%= item.nama_lantai %></td>
            <td data-label="Duplicate Count"><%= item.duplicate_count %></td>
            <td data-label="Record Type"><%= item.record_type %></td>
            
          </tr>
        <% }); %>
      <% } else { %>
          <tr>
            <td colspan="8">Tidak ada data untuk periode ini.</td>
          </tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- START OF UPDATED SECTION -->
<h2>Tabel Aset Rusak & Hilang</h2>

<!-- ASET: Rusak & Hilang -->
<div class="table-pair-container">
  <div class="table-card">
    <h3>Tipe Aset - Rusak</h3>
    <% if (tipeAsetRusak && tipeAsetRusak.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>No</th>
            <th>Aset ID</th>
            <th>Nama Tipe</th>
            <th>Nama Lantai</th>
            <th>Tanggal Deteksi</th>
            <th>Catatan</th>
          </tr>
        </thead>
        <tbody>
          <% tipeAsetRusak.forEach(function(item, index) { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= item.aset_id %></td>
              <td><%= item.aset_name %></td>
              <td><%= item.lantai_name %></td>
              <td><%= item.detected_date %></td>
              <td><%= item.catatan %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <p>Tidak ada data Tipe Aset Rusak.</p>
    <% } %>
  </div>

