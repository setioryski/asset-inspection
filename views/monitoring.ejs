<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Monitoring Data</title>
  <!-- Flatpickr CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <style>
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    th, td {
      padding: 8px 12px;
      border: 1px solid #ccc;
      text-align: left;
    }
    th {
      background-color: #f5f5f5;
    }
    form {
      margin-bottom: 20px;
    }
    label {
      margin-right: 10px;
    }
    input {
      margin-right: 20px;
    }
    #notes {
      margin-bottom: 20px;
      padding: 10px;
      border: 1px solid #ccc;
      background: #f9f9f9;
    }
    #notes h3 {
      margin-bottom: 5px;
    }
    #notes ul {
      list-style-type: disc;
      margin-left: 20px;
    }
  </style>
</head>
<body>
  <h1>Monitoring Data</h1>
  <form action="/monitoring" method="get">
    <label for="startDate">Tanggal Mulai:</label>
    <input type="text" id="startDate" name="startDate" value="<%= startDate %>" placeholder="YYYY-MM-DD 00:00:00">
    <label for="endDate">Tanggal Akhir:</label>
    <input type="text" id="endDate" name="endDate" value="<%= endDate %>" placeholder="YYYY-MM-DD 00:00:00">
    <button type="submit">Tampilkan</button>
  </form>

  <!-- Catatan di bawah datepicker -->
  <div id="notes">
    <h2>Catatan</h2>
    <!-- Catatan untuk lantai tanpa record (duplicate_count = 0) -->
    <h3>Lantai tanpa record (duplicate_count = 0):</h3>
    <ul>
      <% 
        // Filter data untuk record_type 'No Record' (cte_no_aset menghasilkan duplicate_count = 0)
        let floorsNoRecord = data.filter(item => item.record_type === 'No Record');
        if (floorsNoRecord.length === 0) { 
      %>
        <li>Tidak ada lantai tanpa record.</li>
      <% } else { 
           floorsNoRecord.forEach(item => { %>
        <li>Lantai <%= item.nama_lantai %> (ID: <%= item.lantai_id %>) - Tidak ada record.</li>
      <%   });
         } %>
    </ul>

    <!-- Catatan untuk lantai dengan record (duplicate_count = 1) -->
    <h3>Lantai dengan record (duplicate_count = 1):</h3>
    <ul>
      <%
        // Kelompokkan data monitoring berdasarkan lantai, kecuali record 'No Record'
        let grouped = {};
        data.forEach(item => {
          if(item.record_type !== 'No Record') {
            if(!grouped[item.lantai_id]) {
              grouped[item.lantai_id] = { nama_lantai: item.nama_lantai, records: [] };
            }
            grouped[item.lantai_id].records.push(item);
          }
        });
        let keys = Object.keys(grouped);
        if(keys.length === 0) { 
      %>
        <li>Tidak ada lantai dengan record unique.</li>
      <% } else {
           keys.forEach(lantaiId => {
             let group = grouped[lantaiId];
             // Jika setidaknya ada 1 record dengan duplicate_count == 1
             let hasUnique = group.records.some(r => r.duplicate_count == 1);
             if(hasUnique) {
               let monitoringCount = group.records.length;
               // Temukan total aset per lantai dari asetPerLantai
               let asetItem = asetPerLantai.find(a => a.lantai_id == lantaiId);
               let totalAset = asetItem ? asetItem.total_aset : 0;
      %>
        <li>Lantai <%= group.nama_lantai %> (ID: <%= lantaiId %>): Jumlah monitoring record: <%= monitoringCount %> vs Total aset: <%= totalAset %></li>
      <%   }
           });
         }
      %>
    </ul>
  </div>

  <!-- Tabel Monitoring -->
  <table>
    <thead>
      <tr>
        <th>No.</th>
        <th>Row Index per Lantai</th>
        <th>Combined Tipe ID</th>
        <th>Nama Tipe</th>
        <th>Lantai ID</th>
        <th>Nama Lantai</th>
        <th>Duplicate Count</th>
        <th>Record Type</th>
      </tr>
    </thead>
    <tbody>
      <% if (data.length > 0) { %>
        <% data.forEach(function(item){ %>
          <tr>
            <td><%= item.overall_row_index %></td>
            <td><%= item.row_index_per_lantai %></td>
            <td><%= item.combined_tipe_id ? item.combined_tipe_id : '-' %></td>
            <td><%= item.nama_tipe ? item.nama_tipe : '-' %></td>
            <td><%= item.lantai_id %></td>
            <td><%= item.nama_lantai %></td>
            <td><%= item.duplicate_count %></td>
            <td><%= item.record_type %></td>
          </tr>
        <% }); %>
      <% } else { %>
          <tr>
            <td colspan="8">Tidak ada data untuk periode ini.</td>
          </tr>
      <% } %>
    </tbody>
  </table>

  <!-- Flatpickr JS -->
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script>
    // Inisialisasi Flatpickr pada kedua input
    flatpickr("#startDate", {
      enableTime: true,
      time_24hr: true,
      dateFormat: "Y-m-d H:i:S",
      defaultDate: "<%= startDate %>"
    });
    flatpickr("#endDate", {
      enableTime: true,
      time_24hr: true,
      dateFormat: "Y-m-d H:i:S",
      defaultDate: "<%= endDate %>"
    });
  </script>
</body>
</html>
