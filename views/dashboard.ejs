<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/stylesdashboard.css"> <!-- Ensure your CSS path is correct -->

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">

    <!-- jQuery Library (required by DataTables) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

    <style>
        /* Hide the Id column */
        #assetsTable th.id-column,
        #assetsTable td.id-column {
            display: none;
        }

        /* Style for the No. column */
        #assetsTable th.no-column,
        #assetsTable td.no-column {
            width: 50px;
            text-align: center;
        }

        /* Optional: Adjust image size */
        #assetsTable img {
            width: 100px;
            height: auto;
        }

        @media print {
            nav, .filter-container, h1 {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <nav>
        <ul>
            <li><a href="/admin">Admin</a></li>
            <li><a href="/inspection">Inspection</a></li>
            <li><a href="/logOut">Log Out</a></li>
        </ul>
    </nav>

    <h1>Dashboard</h1>
    <div class="dashboard-container">
        <div class="filter-container">
            <form action="/dashboard" method="get" class="date-picker-form">
                <label for="startDate">Start Date:</label>
                <input type="date" id="startDate" name="startDate" value="<%= startDate %>" required>
            
                <label for="endDate">End Date:</label>
                <input type="date" id="endDate" name="endDate" value="<%= endDate %>" required>
                
                <label for="kondisi">Kondisi:</label>
                <select id="kondisi" name="kondisi">
                    <option value="">All Conditions</option>
                    <% kondisiOptions.forEach(option => { %>
                        <option value="<%= option.nama_kondisi %>" <%= kondisi === option.nama_kondisi ? 'selected' : '' %>><%= option.nama_kondisi %></option>
                    <% }); %>
                </select>

                <label for="posisi">Posisi:</label>
                <select name="posisi" id="posisi">
                    <option value="">All Posisi</option>
                    <% posisiOptions.forEach(option => { %>
                        <option value="<%= option.tipe_posisi %>" <%= posisi === option.tipe_posisi ? 'selected' : '' %>><%= option.tipe_posisi %></option>
                    <% }) %>
                </select>
            
                <button type="submit" class="filter-button">Filter</button>
                <button type="button" class="export-button" id="exportPDF">Export to PDF</button>
                <button type="button" class="export-button" id="exportExcel">Export to Excel</button>
            </form>
        </div>
    
        <table id="assetsTable" class="display">
            <thead>
                <tr>
                    <th class="no-column">No.</th> <!-- Numbering column -->
                    <th>Date Created</th>
                    <th>User</th>
                    <th>Asset Type</th>
                    <th>Floor</th>
                    <th>Condition</th>
                    <th>Photo</th>
                    <th>Notes</th>
                    <th class="id-column">Id</th> <!-- Hidden Id column for sorting -->
                </tr>
            </thead>
            <tbody>
                <% assets.forEach((asset) => { %>
                    <tr>
                        <td class="no-column"></td> <!-- "No." column will be filled automatically by DataTables -->
                        <td><%= new Date(asset.tanggal_dibuat).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) %></td>
                        <td><%= asset.user %></td>
                        <td>
                            <% if (asset.nama_tipe_door) { %>
                                <%= asset.nama_tipe_door %>
                            <% } else if (asset.nama_tipe_hb) { %>
                                <%= asset.nama_tipe_hb %>
                            <% } else { %>
                                <%= asset.nama_tipe_aset %>
                            <% } %>
                        </td>
                        <td><%= asset.nama_lantai %></td>
                        <td><%= asset.nama_kondisi %></td>
                        <td>
                            <% if (asset.foto) { %>
                                <img src="<%= asset.foto %>" alt="Asset Photo">
                            <% } else { %>
                                No Image Available
                            <% } %>
                        </td>
                        <td>
                            <% if (asset.catatan) { %>
                                <%- asset.catatan
                                    .split(' ')
                                    .map((word, index) => ((index + 1) % 6 === 0 ? word + '<br>' : word))
                                    .join(' ') 
                                %>
                            <% } else { %>
                                No notes available
                            <% } %>
                        </td>
                        <td class="id-column"><%= asset.id %></td> <!-- Hidden Id value -->
                    </tr>
                <% }); %>
            </tbody>
        </table>

        <script>
            $(document).ready(function() {
                // Initialize DataTables with auto-numbering for the "No." column
                const table = $('#assetsTable').DataTable({
                    "pageLength": 500, // Default number of rows per page
                    "lengthMenu": [ [500, 1000, 2000, -1], [500, 1000, 2000, "All"] ], // Options for rows per page
                    "order": [[8, "asc"]], // Order by the hidden "Id" column ascending (0-based index)
                    "columnDefs": [
                        { 
                            "orderable": false, 
                            "targets": [0, 6, 7] // Disable ordering on "No.", "Photo", and "Notes" columns
                        },
                        { 
                            "visible": false, 
                            "targets": 8 // Hide the "Id" column
                        }
                    ],
                    "language": {
                        "search": "Search:",
                        "lengthMenu": "Show _MENU_ entries",
                        "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                        "paginate": {
                            "first": "First",
                            "last": "Last",
                            "next": "Next",
                            "previous": "Previous"
                        },
                    },
                    "dom": 'lrtip', // Control the table elements: l - length changing input, r - processing display element, t - table, i - table info summary, p - pagination
                    "drawCallback": function(settings) {
                        const api = this.api();
                        // Update the "No." column with sequential numbers
                        api.column(0, { page: 'current' }).nodes().each(function(cell, i) {
                            cell.innerHTML = i + 1 + (api.page.info().page * api.page.info().length);
                        });
                    }
                });

                // Handle Export to PDF
                document.getElementById('exportPDF').addEventListener('click', function() {
                    window.print();
                });

                // Handle Export to Excel
                document.getElementById('exportExcel').addEventListener('click', function() {
                    const startDate = $('#startDate').val();
                    const endDate = $('#endDate').val();
                    const kondisi = $('#kondisi').val();
                    const posisi = $('#posisi').val();
                    window.location.href = `/export/excel?startDate=${startDate}&endDate=${endDate}&kondisi=${kondisi}&posisi=${posisi}`;
                });
            });
        </script>
    </div>
</body>
</html>
