<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Styles -->
  <link rel="stylesheet" href="/stylesdashboard.css?v=<%= Date.now() %>">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

  <style>
    .flatpickr-input { display: none; }
    .myDateInput {
      min-width: 160px;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
      font-family: inherit;
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .myDateInput:focus {
      border-color: #007BFF;
      box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
      outline: none;
    }
    /* Modal styles for the image viewer */
.modal {
  display: none; /* Hidden by default */
  position: fixed;
  z-index: 1100; /* Naikkan nilai z-index agar di atas navbar */
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: auto; /* Enable scroll if needed */
  background-color: rgba(0, 0, 0, 0.9); /* Black with opacity */
}

    .modal-content {
      margin: auto;
      display: block;
      max-width: 90%;
      max-height: 90%;
    }
    .modal-close {
      position: absolute;
      top: 15px;
      right: 35px;
      color: #f1f1f1;
      font-size: 40px;
      font-weight: bold;
      cursor: pointer;
    }
  </style>
</head>

<body>
  <% 
    // Helper function for pagination query string
    function paginationQuery(page) {
      var queryParams = [];
      if (startDate) queryParams.push("startDate=" + encodeURIComponent(startDate));
      if (endDate) queryParams.push("endDate=" + encodeURIComponent(endDate));
      if (kondisi) queryParams.push("kondisi=" + encodeURIComponent(kondisi));
      if (user) queryParams.push("user=" + encodeURIComponent(user));
      if (posisi) queryParams.push("posisi=" + encodeURIComponent(posisi));
      if (floor) queryParams.push("floor=" + encodeURIComponent(floor));
      if (limit) queryParams.push("limit=" + encodeURIComponent(limit));
      queryParams.push("page=" + encodeURIComponent(page));
      return queryParams.join("&");
    }
  %>

  <!-- NAVIGATION -->
  <nav>
    <ul>
      <li><a href="/admin"><i class="fas fa-user-cog"></i> Admin</a></li>
      <li><a href="/inspection"><i class="fas fa-search"></i> Inspection</a></li>
      <li><a href="/monitoring"><i class="fas fa-chart-line"></i> Monitoring</a></li>
      <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </nav>

  <h1>Dashboard</h1>

  <div class="dashboard-container">
    <!-- FILTER FORM -->
    <div class="filter-container">
      <form action="/dashboard" method="get" class="date-picker-form">
        <label for="startDate">Tanggal Mulai:</label>
        <input type="text" id="startDate" name="startDate" required value="<%= startDate || '' %>">

        <label for="endDate">Tanggal Akhir:</label>
        <input type="text" id="endDate" name="endDate" required value="<%= endDate || '' %>">

        <label for="kondisi">Kondisi:</label>
        <select id="kondisi" name="kondisi">
          <option value="">Semua Kondisi</option>
          <% kondisiOptions.forEach(option => { %>
            <option value="<%= option.nama_kondisi %>" <%= kondisi === option.nama_kondisi ? 'selected' : '' %>><%= option.nama_kondisi %></option>
          <% }); %>
        </select>

        <label for="user">User:</label>
        <select id="user" name="user">
          <option value="">Semua User</option>
          <% userOptions.forEach(option => { %>
            <option value="<%= option.name %>" <%= user === option.name ? 'selected' : '' %>><%= option.name %></option>
          <% }); %>
        </select>

        <label for="posisi">Posisi:</label>
        <select name="posisi" id="posisi">
          <option value="">Semua Posisi</option>
          <% posisiOptions.forEach(option => { %>
            <option value="<%= option.tipe_posisi %>" <%= posisi === option.tipe_posisi ? 'selected' : '' %>><%= option.tipe_posisi %></option>
          <% }); %>
        </select>

        <label for="floor">Lantai:</label>
        <select id="floor" name="floor">
          <option value="">Semua Lantai</option>
          <% floorOptions.forEach(option => { %>
            <option value="<%= option.nama_lantai %>" <%= floor === option.nama_lantai ? 'selected' : '' %>><%= option.nama_lantai %></option>
          <% }); %>
        </select>
        <span id="floorLoading" style="display:none;">Loading...</span>

        <label for="limit">Baris per halaman:</label>
        <select name="limit" id="limit">
          <option value="50" <%= limit == 50 ? 'selected' : '' %>>50</option>
          <option value="100" <%= limit == 100 ? 'selected' : '' %>>100</option>
          <option value="500" <%= limit == 500 ? 'selected' : '' %>>500</option>
          <option value="1000" <%= limit == 1000 ? 'selected' : '' %>>1000</option>
        </select>

        <input type="hidden" name="page" value="1">

        <!-- Row 4: Buttons -->
        <div class="button-row">
          <button type="submit" class="filter-button"><i class="fas fa-filter"></i> Filter</button>
          <button type="button" class="export-button" id="exportPDF"><i class="fas fa-file-pdf"></i> Export PDF</button>
          <button type="button" class="export-button" id="exportExcel"><i class="fas fa-file-excel"></i> Export Excel</button>
        </div>
      </form>
    </div>

    <!-- ASSETS TABLE -->
    <table id="assetsTable">
      <thead>
        <tr>
          <th class="no-column">No.</th>
          <th>Tanggal/Waktu</th>
          <th>User</th>
          <th>Jenis Aset</th>
          <th>Lantai</th>
          <th>Kondisi</th>
          <th>Foto</th>
          <th>Catatan</th>
          <th class="id-column">Id</th>
        </tr>
      </thead>
      <tbody>
        <% assets.forEach((asset, index) => { %>
          <%
            let dateObj = null;
            if (typeof asset.client_timestamp === 'string') {
              dateObj = new Date(asset.client_timestamp.replace(' ', 'T'));
            } else if (asset.client_timestamp instanceof Date) {
              dateObj = asset.client_timestamp;
            }
          %>
          <tr>
            <td class="no-column" data-label="No."><%= (currentPage - 1) * limit + index + 1 %></td>
            <td data-label="Tanggal/Waktu">
              <% if (dateObj && !isNaN(dateObj.getTime())) { %>
                <%= dateObj.toLocaleDateString('id-ID') %> <%= dateObj.toLocaleTimeString('id-ID', { hour12: false }) %>
              <% } else { %>
                <span class="invalid-date">Tanggal tidak valid</span>
              <% } %>
            </td>
            <td data-label="User"><%= asset.user %></td>
            <td data-label="Jenis Aset"><%= asset.nama_tipe_door || asset.nama_tipe_hb || asset.nama_tipe_aset %></td>
            <td data-label="Lantai"><%= asset.nama_lantai %></td>
            <td data-label="Kondisi">
              <span class="badge badge-<%= asset.nama_kondisi.toLowerCase() %>">
                <% 
                const kondisi = asset.nama_kondisi?.toLowerCase(); 
                const badgeClass = (kondisi === 'baik' || kondisi === 'rusak') ? kondisi : 'default'; 
              %>
              <span class="badge badge-<%= badgeClass %>">
                <%= asset.nama_kondisi %>
              </span>
              
            </td>
            
            <td data-label="Foto">
              <% if (asset.foto) { %>
                <img src="/<%= asset.foto %>" alt="Foto Aset" class="asset-photo" style="cursor:pointer;">
              <% } else { %>
                <span class="no-image">Tidak Ada Foto</span>
              <% } %>
            </td>
            <td data-label="Catatan">
              <% if (asset.catatan) { %>
                <%- asset.catatan.replace(/(.{40})/g, "$1<br>") %>
              <% } else { %>
                <span class="no-notes">Tidak ada catatan</span>
              <% } %>
            </td>
            <td class="id-column"><%= asset.id %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <!-- PAGINATION -->
    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a href="?<%= paginationQuery(currentPage - 1) %>">« Sebelumnya</a>
      <% } else { %>
        <span class="disabled">« Sebelumnya</span>
      <% } %>

      <% for(let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
        <% if(i === currentPage) { %>
          <span class="current"><%= i %></span>
        <% } else { %>
          <a href="?<%= paginationQuery(i) %>"><%= i %></a>
        <% } %>
      <% } %>

      <% if (currentPage < totalPages) { %>
        <a href="?<%= paginationQuery(currentPage + 1) %>">Berikutnya »</a>
      <% } else { %>
        <span class="disabled">Berikutnya »</span>
      <% } %>
    </div>
  </div>

  <!-- Modal for Image Viewer -->
  <div id="imageModal" class="modal">
    <span class="modal-close">&times;</span>
    <img class="modal-content" id="modalImage">
  </div>

  <!-- FLATPICKR & INTERACTIONS -->
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script>
flatpickr("#startDate", {
  disableMobile: true,
  enableTime: true,
  time_24hr: true,
  defaultHour: 0,
  defaultMinute: 0,
  dateFormat: "Y-m-d H:i:S",
  altInput: true,
  altFormat: "d-m-Y H:i:S",
  altInputClass: "myDateInput"
});

flatpickr("#endDate", {
  disableMobile: true,
  enableTime: true,
  time_24hr: true,
  defaultHour: 0,
  defaultMinute: 0,
  dateFormat: "Y-m-d H:i:S",
  altInput: true,
  altFormat: "d-m-Y H:i:S",
  altInputClass: "myDateInput"
});


    document.getElementById('exportPDF').addEventListener('click', () => window.print());

    document.getElementById('exportExcel').addEventListener('click', () => {
      const queryParams = new URLSearchParams({
        startDate: document.getElementById('startDate').value,
        endDate: document.getElementById('endDate').value,
        kondisi: document.getElementById('kondisi').value,
        user: document.getElementById('user').value,
        posisi: document.getElementById('posisi').value,
        floor: document.getElementById('floor').value
      }).toString();
      window.location.href = `/export/excel?${queryParams}`;
    });

    const posisiSelect = document.getElementById('posisi');
    const floorSelect = document.getElementById('floor');
    const floorLoading = document.getElementById('floorLoading');

    async function fetchFloors(posisi) {
      floorLoading.style.display = 'inline';
      try {
        const res = await fetch(`/getFloors?posisi=${encodeURIComponent(posisi)}`);
        const floors = await res.json();
        floorSelect.innerHTML = '<option value="">Semua Lantai</option>';
        floors.forEach(f => {
          const opt = document.createElement('option');
          opt.value = f.nama_lantai;
          opt.textContent = f.nama_lantai;
          floorSelect.appendChild(opt);
        });
      } catch {
        alert('Gagal memuat data lantai.');
      } finally {
        floorLoading.style.display = 'none';
      }
    }

    posisiSelect.addEventListener('change', () => fetchFloors(posisiSelect.value));
    fetchFloors(posisiSelect.value);

    // Image Modal functionality
    const modal = document.getElementById('imageModal');
    const modalImg = document.getElementById('modalImage');
    const closeModal = document.querySelector('.modal-close');

    // Attach event listener to each asset photo to open the modal viewer
    document.querySelectorAll('.asset-photo').forEach(img => {
      img.addEventListener('click', () => {
        modal.style.display = 'block';
        modalImg.src = img.src;
      });
    });

    // Close modal when clicking on the close button
    closeModal.addEventListener('click', () => {
      modal.style.display = 'none';
    });

    // Optionally, close modal when clicking outside the image
    modal.addEventListener('click', (event) => {
      if (event.target === modal) {
        modal.style.display = 'none';
      }
    });
  </script>
</body>
</html>
