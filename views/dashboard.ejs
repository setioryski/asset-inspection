<!DOCTYPE html>
<html lang="id"> <!-- Indonesian language -->
<head>
    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <!-- Stylesheet -->
    <link rel="stylesheet" href="/stylesdashboard.css">
    <!-- Include Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <!-- Optional: DataTables CSS for enhanced table features -->
    <!-- <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css"> -->
</head>
<body>
    <!-- Navigation Bar -->
    <nav>
        <ul>
            <li><a href="/admin"><i class="fas fa-user-cog"></i> Admin</a></li>
            <li><a href="/inspection"><i class="fas fa-search"></i> Inspection</a></li>
            <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
        </ul>
    </nav>

    <!-- Page Title -->
    <h1>Dashboard</h1>

    <div class="dashboard-container">
        <!-- Filter Form -->
        <div class="filter-container">
            <form action="/dashboard" method="get" class="date-picker-form">
                <!-- Start Date -->
                <label for="startDate">Tanggal Mulai:</label>
                <input type="date" id="startDate" name="startDate" value="<%= startDate %>" required>

                <!-- End Date -->
                <label for="endDate">Tanggal Akhir:</label>
                <input type="date" id="endDate" name="endDate" value="<%= endDate %>" required>

                <!-- Kondisi (Condition) -->
                <label for="kondisi">Kondisi:</label>
                <select id="kondisi" name="kondisi">
                    <option value="">Semua Kondisi</option>
                    <% kondisiOptions.forEach(option => { %>
                        <option value="<%= option.nama_kondisi %>" <%= kondisi === option.nama_kondisi ? 'selected' : '' %>><%= option.nama_kondisi %></option>
                    <% }); %>
                </select>

                <!-- Posisi (Position) -->
                <label for="posisi">Posisi:</label>
                <select name="posisi" id="posisi">
                    <option value="">Semua Posisi</option>
                    <% posisiOptions.forEach(option => { %>
                        <option value="<%= option.tipe_posisi %>" <%= posisi === option.tipe_posisi ? 'selected' : '' %>><%= option.tipe_posisi %></option>
                    <% }); %>
                </select>

                <!-- Rows per page -->
                <label for="limit">Baris per halaman:</label>
                <select name="limit" id="limit">
                    <option value="50" <%= limit == 50 ? 'selected' : '' %>>50</option>
                    <option value="100" <%= limit == 100 ? 'selected' : '' %>>100</option>
                    <option value="500" <%= limit == 500 ? 'selected' : '' %>>500</option>
                    <option value="1000" <%= limit == 1000 ? 'selected' : '' %>>1000</option>
                </select>

                <!-- Reset to first page on filter change -->
                <input type="hidden" name="page" value="1">

                <!-- Action Buttons -->
                <button type="submit" class="filter-button"><i class="fas fa-filter"></i> Filter</button>
                <button type="button" class="export-button" id="exportPDF"><i class="fas fa-file-pdf"></i> Export ke PDF</button>
                <button type="button" class="export-button" id="exportExcel"><i class="fas fa-file-excel"></i> Export ke Excel</button>
            </form>
        </div>

        <!-- Assets Table -->
        <table id="assetsTable">
            <thead>
                <tr>
                    <th class="no-column">No.</th> <!-- Numbering column -->
                    <th>Tanggal/Waktu</th> <!-- Changed Header -->
                    <th>User</th>
                    <th>Jenis Aset</th>
                    <th>Lantai</th>
                    <th>Kondisi</th>
                    <th>Foto</th>
                    <th>Catatan</th>
                    <th class="id-column">Id</th> <!-- Hidden Id column for sorting -->
                </tr>
            </thead>
            <tbody>
                <% assets.forEach((asset, index) => { %>
                    <tr>
                        <!-- Continuous Row Number -->
                        <td class="no-column"><%= (currentPage - 1) * limit + index + 1 %></td>

                        <!-- Date Created from client_timestamp -->
                        <% 
                            let dateCreated = asset.client_timestamp;
                            let dateObj = null;

                            if (typeof dateCreated === 'string') {
                                // Replace space with 'T' to make ISO format
                                let dateISO = dateCreated.replace(' ', 'T');
                                dateObj = new Date(dateISO);
                            } else if (dateCreated instanceof Date) {
                                dateObj = dateCreated;
                            }
                        %>
                        <td>
                            <% if (dateObj && !isNaN(dateObj.getTime())) { %>
                                <%= dateObj.toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'medium' }).replace(/\./g, ':') %>
                            <% } else { %>
                                <span class="invalid-date">Tanggal tidak valid</span>
                            <% } %>
                        </td>

                        <!-- User -->
                        <td><%= asset.user %></td>

                        <!-- Asset Type: Door, Hydrant, or Asset -->
                        <td>
                            <% if (asset.nama_tipe_door) { %>
                                <%= asset.nama_tipe_door %>
                            <% } else if (asset.nama_tipe_hb) { %>
                                <%= asset.nama_tipe_hb %>
                            <% } else { %>
                                <%= asset.nama_tipe_aset %>
                            <% } %>
                        </td>

                        <!-- Floor -->
                        <td><%= asset.nama_lantai %></td>

                        <!-- Condition -->
                        <td><%= asset.nama_kondisi %></td>

                        <!-- Photo -->
                        <td>
                            <% if (asset.foto) { %>
                                <img src="/<%= asset.foto %>" alt="Foto Aset" class="asset-photo">
                            <% } else { %>
                                <span class="no-image">Tidak Ada Foto</span>
                            <% } %>
                        </td>

                        <!-- Notes with Word Wrapping -->
                        <td>
                            <% if (asset.catatan) { %>
                                <%- asset.catatan
                                    .split(' ')
                                    .map((word, idx) => ((idx + 1) % 6 === 0 ? word + '<br>' : word))
                                    .join(' ') 
                                %>
                            <% } else { %>
                                <span class="no-notes">Tidak ada catatan</span>
                            <% } %>
                        </td>

                        <!-- Hidden Id Column (optional for sorting or identification) -->
                        <td class="id-column"><%= asset.id %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

        <!-- Pagination Controls -->
        <div class="pagination">
            <% if (currentPage > 1) { %>
                <a href="?startDate=<%= encodeURIComponent(startDate) %>&endDate=<%= encodeURIComponent(endDate) %>&kondisi=<%= encodeURIComponent(kondisi) %>&posisi=<%= encodeURIComponent(posisi) %>&limit=<%= limit %>&page=<%= currentPage - 1 %>">« Sebelumnya</a>
            <% } else { %>
                <span class="disabled">« Sebelumnya</span>
            <% } %>

            <% 
                // Limit the number of page links displayed
                const maxPagesToShow = 5;
                let startPage = Math.max(1, currentPage - Math.floor(maxPagesToShow / 2));
                let endPage = startPage + maxPagesToShow - 1;

                if (endPage > totalPages) {
                    endPage = totalPages;
                    startPage = Math.max(1, endPage - maxPagesToShow + 1);
                }
            %>

            <% for(let i = startPage; i <= endPage; i++) { %>
                <% if(i === currentPage) { %>
                    <span class="current"><%= i %></span>
                <% } else { %>
                    <a href="?startDate=<%= encodeURIComponent(startDate) %>&endDate=<%= encodeURIComponent(endDate) %>&kondisi=<%= encodeURIComponent(kondisi) %>&posisi=<%= encodeURIComponent(posisi) %>&limit=<%= limit %>&page=<%= i %>"><%= i %></a>
                <% } %>
            <% } %>

            <% if (currentPage < totalPages) { %>
                <a href="?startDate=<%= encodeURIComponent(startDate) %>&endDate=<%= encodeURIComponent(endDate) %>&kondisi=<%= encodeURIComponent(kondisi) %>&posisi=<%= encodeURIComponent(posisi) %>&limit=<%= limit %>&page=<%= currentPage + 1 %>">Selanjutnya »</a>
            <% } else { %>
                <span class="disabled">Selanjutnya »</span>
            <% } %>
        </div>

        <!-- Scripts -->
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const startDateInput = document.getElementById('startDate');
                const endDateInput = document.getElementById('endDate');

                // Function to format date to YYYY-MM-DD
                const formatDate = (date) => {
                    let day = date.getDate();
                    let month = date.getMonth() + 1; // Months are zero-based
                    const year = date.getFullYear();

                    if (day < 10) {
                        day = '0' + day;
                    }
                    if (month < 10) {
                        month = '0' + month;
                    }
                    return `${year}-${month}-${day}`;
                };

                // Set default dates if not provided
                if (!startDateInput.value) {
                    const currentDate = new Date();
                    const firstDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
                    startDateInput.value = formatDate(firstDayOfMonth);
                }

                if (!endDateInput.value) {
                    const currentDate = new Date();
                    const lastDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
                    endDateInput.value = formatDate(lastDayOfMonth);
                }

                // Validate dates: End Date must be after Start Date
                const validateDates = () => {
                    const startDate = new Date(startDateInput.value);
                    const endDate = new Date(endDateInput.value);
                    if (startDate > endDate) {
                        alert('Tanggal Akhir harus lebih dari Tanggal Mulai.');
                        return false;
                    }
                    return true;
                };

                startDateInput.addEventListener('change', validateDates);
                endDateInput.addEventListener('change', validateDates);

                // Handle Export to PDF
                document.getElementById('exportPDF').addEventListener('click', function() {
                    const queryParams = new URLSearchParams({
                        startDate: startDateInput.value,
                        endDate: endDateInput.value,
                        kondisi: document.getElementById('kondisi').value,
                        posisi: document.getElementById('posisi').value,
                        limit: document.getElementById('limit').value
                    }).toString();
                    window.location.href = `/export/pdf?${queryParams}`;
                });

                // Handle Export to Excel
                document.getElementById('exportExcel').addEventListener('click', function() {
                    const queryParams = new URLSearchParams({
                        startDate: startDateInput.value,
                        endDate: endDateInput.value,
                        kondisi: document.getElementById('kondisi').value,
                        posisi: document.getElementById('posisi').value,
                        limit: document.getElementById('limit').value
                    }).toString();
                    window.location.href = `/export/excel?${queryParams}`;
                });
            });
        </script>

        <!-- Optional: DataTables Initialization -->
        <!-- 
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
        <script>
            $(document).ready(function() {
                $('#assetsTable').DataTable({
                    "paging": false, // Disable DataTables paging since server-side paging is implemented
                    "info": false,   // Disable info display
                    "searching": false, // Disable searching
                    "ordering": true, // Enable column ordering
                    "columnDefs": [
                        { "orderable": false, "targets": [0, 6, 7] } // Disable ordering on No., Photo, and Notes columns
                    ]
                });
            });
        </script>
        -->
    </div>
</body>
</html>
