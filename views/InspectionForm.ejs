<!DOCTYPE html>
<html lang="id">
<head>
    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Formulir Inspeksi Aset</title>
    <!-- Stylesheet -->
    <link rel="stylesheet" href="/stylesinspection.css">
    <!-- Include Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
</head>
<body>
    <!-- Online/Offline Status Indicator -->
    <div id="statusIndicator" style="display: none;">Anda sedang offline. Data akan disimpan secara lokal.</div>

    <!-- Notification Element -->
    <div id="notification" role="alert" aria-live="assertive">
        <span class="icon"></span>
        <span class="message"></span>
    </div>

    <!-- Navigation Bar -->
    <nav>
        <ul>
            <li><a href="/admin"><i class="fas fa-user-cog"></i> Admin</a></li>
            <li><a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
            <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
        </ul>
    </nav>

    <!-- Page Title -->
    <h1>Formulir Inspeksi Aset</h1>

    <!-- Inspection Form -->
    <form id="inspectionForm">
        <!-- Nama Petugas -->
        <div>
            <label for="id_user"><i class="fas fa-user"></i> Nama Petugas:</label>
            <select id="id_user" name="id_user" required>
                <option value="<%= user.id %>"><%= user.name %></option>
            </select>
        </div>

        <!-- Step 1: Choose Floor (Lantai) -->
        <div>
            <label for="id_tipe_lantai"><i class="fas fa-building"></i> Lantai:</label>
            <select id="id_tipe_lantai" name="id_tipe_lantai" required>
                <option value="" selected disabled>Pilih Lantai</option>
                <% tipe_lantai.forEach(function(tl) { %>
                    <option value="<%= tl.id %>"><%= tl.nama_lantai %></option>
                <% }); %>
            </select>
        </div>

        <!-- Assets Status Section -->
        <div id="assetsStatus" style="display: none;">
            <h2>Status Aset pada Lantai Terpilih</h2>
            <ul id="assetsStatusList"></ul>
        </div>

        <!-- Note -->
        <div class="field-note">
            <p>Pilih salah satu dari ketiga kategori aset ini, jika salah pilih mohon refresh halaman.</p>
        </div>

        <!-- Step 2: Choose Asset or Box Hydrant or Emergency Door -->
        <div>
            <label for="id_tipe_aset"><i class="fas fa-box"></i> Nama Aset:</label>
            <select id="id_tipe_aset" name="id_tipe_aset" disabled>
                <option value="" selected disabled>Pilih Aset</option>
                <% tipe_aset.forEach(function(ta) { %>
                    <option value="<%= ta.id %>" data-lantai="<%= ta.lantai_id %>"><%= ta.nama_tipe %></option>
                <% }); %>
            </select>
        </div>

        <div>
            <label for="id_tipe_hb"><i class="fas fa-fire-extinguisher"></i> Box Hydrant:</label>
            <select id="id_tipe_hb" name="id_tipe_hb" disabled>
                <option value="" selected disabled>Pilih Box Hydrant</option>
                <% tipe_hb.forEach(function(hb) { %>
                    <option value="<%= hb.id %>" data-lantai="<%= hb.lantai_id %>"><%= hb.nama_tipe %></option>
                <% }); %>
            </select>
        </div>

        <div>
            <label for="id_tipe_door"><i class="fas fa-door-open"></i> Emergency Door:</label>
            <select id="id_tipe_door" name="id_tipe_door" disabled>
                <option value="" selected disabled>Pilih Emergency Door</option>
                <% tipe_door.forEach(function(door) { %>
                    <option value="<%= door.id %>" data-lantai="<%= door.lantai_id %>"><%= door.nama_tipe %></option>
                <% }); %>
            </select>
        </div>

        <!-- Step 3: Take Picture (Foto) -->
        <div>
            <label for="foto"><i class="fas fa-camera"></i> Foto:</label>
            <input 
                type="file" 
                id="foto" 
                name="foto" 
                accept="image/*" 
                capture="environment" 
                required 
            >
            <img id="previewImg" src="" style="display: none;" alt="Image Preview">
        </div>

        <!-- Step 4: Choose Kondisi (Condition) -->
        <div>
            <label for="id_kondisi"><i class="fas fa-clipboard-check"></i> Kondisi:</label>
            <select id="id_kondisi" name="id_kondisi" required disabled>
                <option value="" selected disabled>Pilih Kondisi</option>
                <% tipe_kondisi.forEach(function(tk) { %>
                    <option value="<%= tk.id %>"><%= tk.nama_kondisi %></option>
                <% }); %>
            </select>
        </div>

        <!-- Catatan (Optional) -->
        <div>
            <label for="catatan">Catatan:</label>
            <textarea id="catatan" name="catatan"></textarea>
        </div>

        <!-- Note -->
        <div class="field-note">
            <p>Tombol "Simpan Lokal" hanya untuk menyimpan sementara, klik tombol "Kirim Semua" dalam tombol "Tampilkan Data Tersimpan" untuk menyimpan ke database.</p>
        </div>

        <!-- Step 5: Submit -->
        <div class="button-group">
            <!-- Save Button -->
            <button type="button" id="saveButton"><i class="fas fa-save"></i> Simpan Lokal</button>
            <!-- Toggle Data Tersimpan Button -->
            <button type="button" id="toggleSavedEntriesButton"><i class="fas fa-folder-open"></i> Tampilkan Data Tersimpan</button>
        </div>
    </form>

    <!-- Saved Entries Section -->
    <div id="savedEntries" style="display: none;">
        <h2>Data Tersimpan</h2>
        <ul id="entryList"></ul>
        <!-- Kirim Semua Button with Spinner -->
        <button type="button" id="kirimSemuaButton" disabled><i class="fas fa-paper-plane"></i> Kirim Semua</button>
        <div class="spinner" id="kirimSemuaSpinner" style="display: none;"></div>
    </div>

<!-- Reference to main.js -->
<script src="/js/main.js"></script>


</body>
</html>
