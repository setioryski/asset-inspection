# .env.deploy

# =====================
# Server Configuration
# =====================

# Session Secret (used to sign session ID cookies)
SESSION_SECRET=0

# =====================
# Redis Configuration
# =====================

# Redis server host (usually '127.0.0.1' for local)
REDIS_HOST=127.0.0.1

# Redis server port (default is 6379)
REDIS_PORT=6379

# Redis password (leave blank if not set)
REDIS_PASSWORD=your_redis_password_if_any

# =====================
# Database Configuration
# =====================

# Database host
DB_HOST=localhost

# Database user
DB_USER=root

# Database password
DB_PASSWORD=

# Database name
DB_NAME=web01

# =====================
# Other Configurations
# =====================

# Application Port (optional, defaults to 3000 if not set)
PORT=3000

# =====================
# Optional Configurations
# =====================

# If you have other environment-specific variables, add them below
# EXAMPLE_VARIABLE=value
